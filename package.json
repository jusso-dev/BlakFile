{
  "name": "blakfile",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "BlakFile — secure, AI-native, multi-tenant enterprise file sharing & governance platform",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:rls": "tsx src/db/apply-rls.ts",
    "db:setup": "npm run db:migrate && npm run db:rls && npm run db:seed",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "screenshot": "tsx scripts/capture-readme-screenshot.ts",
    "worker": "tsx src/worker/index.ts",
    "mcp": "tsx src/mcp/stdio.ts"
  },
  "dependencies": {
    "next": "16.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "better-auth": "^1.2.0",
    "drizzle-orm": "^0.44.0",
    "postgres": "^3.4.5",
    "pg": "^8.13.0",
    "zod": "^3.24.0",
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "lucide-react": "^0.468.0",
    "tailwindcss": "^4.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "pino-pretty": "^13.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0",
    "@vitest/coverage-v8": "^2.1.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@playwright/test": "^1.49.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.0.0"
  }
}
