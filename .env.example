# =============================================================================
# BlakFile — environment template
# Copy to .env.local (dev) or provide via your secrets manager (prod).
# NEVER commit a filled-in .env. No secret in this file is a real secret.
# =============================================================================

# --- Core ---
NODE_ENV=development
APP_URL=http://localhost:3000
# 32+ byte random string. Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=dev-only-change-me-openssl-rand-base64-48

# --- Database (PostgreSQL 16+ with pgvector) ---
# The APP connects as the low-privilege, NOBYPASSRLS role so tenant RLS applies.
DATABASE_URL=postgres://blakfile_app:blakfile@localhost:5432/blakfile
# High-privilege owner connection for migrations, RLS setup, and seeding only
# (bypasses RLS by ownership). Never used by request-serving code.
DATABASE_MIGRATION_URL=postgres://blakfile:blakfile@localhost:5432/blakfile

# --- Redis (queue + cache; provider abstracted) ---
REDIS_URL=redis://localhost:6379
QUEUE_DRIVER=bullmq            # bullmq | pg
CACHE_DRIVER=redis            # redis | memory

# --- Object storage (provider abstracted; MinIO in dev) ---
STORAGE_DRIVER=s3            # s3 | r2 | azure | gcs | local
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=ap-southeast-2
STORAGE_BUCKET=blakfile-dev
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true
# Signed URL lifetime (seconds). Keep short.
STORAGE_SIGNED_URL_TTL=120

# --- KMS / encryption (abstracted; local dev uses a static key) ---
KMS_DRIVER=local            # local | aws-kms | azure-kv | gcp-kms | vault
# Local dev master key ONLY. Generate: openssl rand -base64 32
KMS_LOCAL_MASTER_KEY=dev-only-change-me-openssl-rand-base64-32

# --- AI (disabled by default; provider-neutral) ---
AI_ENABLED=false
AI_DRIVER=ollama            # ollama | openai | azure-openai | anthropic | google | bedrock | disabled
AI_BASE_URL=http://localhost:11434
AI_EMBEDDING_MODEL=nomic-embed-text
AI_CHAT_MODEL=llama3.1
# Never send customer content to a hosted provider unless org policy allows it.
AI_ALLOW_HOSTED_PROVIDERS=false

# --- Malware scanning (abstracted) ---
MALWARE_DRIVER=clamav        # clamav | none | vendor
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- Observability ---
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Data residency default for new orgs ---
DEFAULT_DATA_RESIDENCY=ap-southeast-2
